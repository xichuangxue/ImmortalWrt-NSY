if part uuid ${devtype} ${devnum}:2 rootuuid; then
    setenv bootargs "coherent_pool=2M console=tty1 console=ttyS2,1500000 earlycon=uart8250,mmio32,0xfe660000 root=PARTUUID=${rootuuid} rw rootwait"
    if load ${devtype} ${devnum}:1 ${kernel_addr_r} kernel.img; then
        if load ${devtype} ${devnum}:1 ${fdt_addr_r} rockchip.dtb; then
            booti ${kernel_addr_r} - ${fdt_addr_r}
        fi
    fi
fi
